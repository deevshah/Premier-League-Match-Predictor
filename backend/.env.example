# Create a local .env file with these variables
# Copy this file to .env and update the values

# Debug mode
DEBUG=False

# Database Configuration
# For local development with SQLite:
DATABASE_URL=sqlite+aiosqlite:///./premier_league.db

# For PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/premier_league
# 
# For Render PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@hostname:5432/database
# (Get this from Render dashboard)

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://your-vercel-app.vercel.app

# Model paths (relative to backend root)
MODEL_FILE_PATH=data/model.joblib
FEATURE_META_FILE_PATH=data/feature_meta.json
REFERENCE_DATA_FILE_PATH=data/features_reference.csv
